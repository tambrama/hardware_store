# Store Python (Flask) example env (Docker Compose)
# Copy to store_python/.env and tweak if needed.
PORT=5000
DATABASE_URI=postgresql://postgres:postgres@db-shopapi:5432/shopapi

# Auth-service gRPC
AUTH_GRPC_HOST=auth-service
AUTH_GRPC_PORT=9090
APP_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890

# Redis cache
REDIS_URL=redis://redis:6379/0

# Kafka consumer (enable only on main instance)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=product-updates
KAFKA_GROUP_ID=store_python_gateway
KAFKA_CONSUMER_ENABLED=1

# Photo-service
PHOTO_SERVICE_URL=http://photo-service:8000

