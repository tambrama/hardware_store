# Пример для двух дополнительных инстансов бэкенда (порты 5001 и 5002)
# Скопируй в .env.replica1 и .env.replica2 и задай PORT и пользователя БД только на чтение.
#
# В PostgreSQL создай пользователя только для чтения (уже есть в docker init):
#   shop_readonly / readonly

# Реплика 1 (порт 5001)
PORT=5001
DATABASE_URI=postgresql://shop_readonly:readonly@localhost:5432/shopapi

# Реплика 2: скопируй этот файл как .env.replica2 и поставь PORT=5002
